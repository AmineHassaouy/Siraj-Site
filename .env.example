# Contact form delivery (https://resend.com). Without these, the form works in
# development (the message is logged to the server console) and returns a
# "not configured" error in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=sirajagency1@gmail.com
# Must be an address on a domain verified in Resend, e.g. "SIRAJ <contact@siraj.ma>"
CONTACT_FROM_EMAIL=
